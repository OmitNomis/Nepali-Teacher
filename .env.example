# Your domain (point an A record at the VPS first; Caddy fetches HTTPS certs)
DOMAIN=nepali.example.com

# TTS for placeholder audio: azure | google | edge | none
#   azure:  official Microsoft Speech, free tier is plenty. Needs a key.
#   edge:   Microsoft Edge's voice. No key, unofficial; falls back to google.
#   google: Google Translate's voice. No key, unofficial, more robotic.
TTS_PROVIDER=edge
# azure/edge: a voice name like ne-NP-HemkalaNeural (f) or ne-NP-SagarNeural (m);
# google: a language code (ne)
# TTS_VOICE=ne-NP-HemkalaNeural
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus

# The daily review's new cards reset at 4am in the server's time zone. Containers
# run in UTC, which would put that at 1pm in Japan.
TZ=Asia/Tokyo
